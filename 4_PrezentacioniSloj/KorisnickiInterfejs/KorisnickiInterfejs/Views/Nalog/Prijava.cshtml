@model PrezentacionaLogika.PogledModeli.PrijavaPrikazModel
@{ ViewBag.Title = "Prijava"; }

<div class="login-wrap">
    <section class="login-card">
        <div class="login-card-header">
            <p class="page-kicker">Zaštićeni pristup</p>
            <h2>Prijava korisnika</h2>
        </div>
        <div class="login-card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
                <div class="form-group">
                    <label>Korisničko ime</label>
                    @Html.TextBoxFor(m => m.KorisnickoIme, new { @class = "form-control", autocomplete = "username" })
                </div>
                <div class="form-group">
                    <label>Lozinka</label>
                    @Html.PasswordFor(m => m.Sifra, new { @class = "form-control", autocomplete = "current-password" })
                </div>
                <input type="submit" value="Prijava" class="btn btn-accent btn-block" />
            }
        </div>
    </section>
</div>
