<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Evidencija članstva sportskog kluba</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="app-shell">
        @if (Session["IDKorisnika"] != null)
        {
        <aside class="app-sidebar no-print">
            <a class="app-brand" href="@Url.Action("Pocetna", "Pocetna")">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 120 120" focusable="false">
                        <circle class="guest-emblem-ring" cx="60" cy="60" r="52"></circle>
                        <path class="guest-emblem-laurel" d="M31 83c-10-10-15-23-13-38M89 83c10-10 15-23 13-38"></path>
                        <path class="guest-emblem-leaves" d="M24 69l-10-3m12-8-9-7m13-3-5-11M96 69l10-3m-12-8 9-7m-13-3 5-11"></path>
                        <path class="guest-emblem-shield" d="M60 25l27 10v22c0 20-11 34-27 42-16-8-27-22-27-42V35z"></path>
                        <text class="guest-emblem-monogram" x="60" y="67" text-anchor="middle">SK</text>
                    </svg>
                </span>
                <span class="brand-copy">
                    <strong>Sportski klub</strong>
                    <small>Evidencija članstva</small>
                </span>
            </a>
            <ul class="app-nav">
                <li><a class="nav-primary" href="@Url.Action("Dodaj", "ZahtevZaUclanjenje")"><span class="nav-symbol glyphicon glyphicon-plus"></span>Novi zahtev</a></li>
                <li><a href="@Url.Action("Pocetna", "Pocetna")"><span class="nav-symbol glyphicon glyphicon-home"></span>Početna</a></li>
                <li><a href="@Url.Action("Spisak", "ZahtevZaUclanjenje")"><span class="nav-symbol glyphicon glyphicon-list-alt"></span>Zahtevi</a></li>
                <li>
                    <a class="rest-nav-link" href="@System.Configuration.ConfigurationManager.AppSettings["RestServisOsnovnaAdresa"]" target="_blank" rel="noopener">
                        <span class="nav-symbol glyphicon glyphicon-transfer"></span>REST servis
                    </a>
                </li>
            </ul>
            <div class="sidebar-note">Evidencija učlanjivanja kandidata u sportski klub</div>
        </aside>
        }
        else
        {
        <aside class="guest-brand-rail no-print" aria-label="Identitet sportskog kluba">
            <div class="guest-brand-content">
                <div class="guest-sport-emblem" aria-hidden="true">
                    <svg viewBox="0 0 120 120" focusable="false">
                        <circle class="guest-emblem-ring" cx="60" cy="60" r="52"></circle>
                        <path class="guest-emblem-laurel" d="M31 83c-10-10-15-23-13-38M89 83c10-10 15-23 13-38"></path>
                        <path class="guest-emblem-leaves" d="M24 69l-10-3m12-8-9-7m13-3-5-11M96 69l10-3m-12-8 9-7m-13-3 5-11"></path>
                        <path class="guest-emblem-shield" d="M60 25l27 10v22c0 20-11 34-27 42-16-8-27-22-27-42V35z"></path>
                        <text class="guest-emblem-monogram" x="60" y="67" text-anchor="middle">SK</text>
                    </svg>
                </div>
                <div class="guest-brand-copy">
                    <span class="guest-brand-kicker">Sportski identitet</span>
                    <strong>Sportski klub</strong>
                    <small>Evidencija članstva</small>
                </div>
                <div class="guest-brand-motto">Disciplina <span>•</span> Snaga <span>•</span> Tim</div>
            </div>
            <div class="guest-brand-note">Zaštićeni pristup informacionom sistemu</div>
        </aside>
        }

        <main class="app-main @(Session["IDKorisnika"] == null ? "app-main-guest" : "")">
            <header class="app-topbar no-print clearfix">
                <div class="topbar-context">
                    <span class="eyebrow">Informacioni sistem</span>
                    <span class="context-title">@ViewBag.Title</span>
                </div>
                <div class="topbar-user">
                    @if (Session["IDKorisnika"] != null)
                    {
                        <span class="user-name">@Session["Ime"] @Session["Prezime"]</span>
                        <span class="user-role">@Session["Uloga"] · @Html.ActionLink("Odjava", "Odjava", "Nalog")</span>
                    }
                    else
                    {
                        <span class="user-name">Gost</span>
                        <span class="user-role">@Html.ActionLink("Prijava", "Prijava", "Nalog")</span>
                    }
                </div>
            </header>

            <div class="body-content">
                @RenderBody()
            </div>
            <footer class="app-footer no-print">
                &copy; @DateTime.Now.Year · Evidencija učlanjivanja kandidata u sportski klub
            </footer>
        </main>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
