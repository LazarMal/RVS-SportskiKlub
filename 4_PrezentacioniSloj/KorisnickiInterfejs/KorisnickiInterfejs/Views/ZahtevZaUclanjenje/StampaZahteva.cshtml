@model KlasePodataka.ZahtevZaUclanjenje
@{ Layout = null; var roditelj = Model.RoditeljiStaratelji.FirstOrDefault(); }
<!doctype html><html><head><meta charset="utf-8" /><title>@Model.BrojZahteva</title><style>body{font-family:Arial;margin:24px;color:#111}.document{max-width:850px;margin:auto;border:2px solid #222;padding:24px}h1{text-align:center;font-size:23px}h2{font-size:17px;border-bottom:1px solid #333;padding-bottom:4px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:7px 25px}.field{border-bottom:1px dotted #888;padding:4px}.label{font-size:11px;color:#555;display:block}.docs{width:100%;border-collapse:collapse}.docs td,.docs th{border:1px solid #555;padding:5px}.signatures{display:flex;justify-content:space-between;margin-top:55px}.actions{margin-bottom:16px}@@media print{.actions{display:none}.document{border:0;padding:0}}</style></head><body>
<div class="actions"><button onclick="window.print()">Štampaj zahtev</button></div><div class="document">
<h1>ZAHTEV ZA UČLANJENJE U SPORTSKI KLUB</h1>
<div class="grid"><div class="field"><span class="label">Broj zahteva</span>@Model.BrojZahteva</div><div class="field"><span class="label">Datum i mesto</span>@Model.DatumPodnosenja.ToString("dd.MM.yyyy"), @Model.MestoKluba</div><div class="field"><span class="label">Sezona</span>@Model.Sezona</div><div class="field"><span class="label">Status</span>@Model.StatusZahteva</div></div>
<h2>Podaci o kandidatu</h2><div class="grid"><div class="field"><span class="label">Ime i prezime</span>@Model.Kandidat.Ime @Model.Kandidat.Prezime</div><div class="field"><span class="label">JMBG</span>@Model.Kandidat.JMBG</div><div class="field"><span class="label">Datum rođenja / pol</span>@Model.Kandidat.DatumRodjenja.ToString("dd.MM.yyyy") / @Model.Kandidat.Pol</div><div class="field"><span class="label">Državljanstvo</span>@Model.Kandidat.Drzavljanstvo</div><div class="field"><span class="label">Adresa</span>@Model.Kandidat.Adresa</div><div class="field"><span class="label">Telefon / email</span>@Model.Kandidat.KontaktTelefon / @Model.Kandidat.Email</div></div>
<h2>Sportski podaci</h2><div class="grid"><div class="field"><span class="label">Disciplina</span>@Model.SportskaDisciplina.Naziv</div><div class="field"><span class="label">Datum sportskog pregleda</span>@Model.DatumSportskogPregleda.ToString("dd.MM.yyyy")</div><div class="field"><span class="label">Rezultat testa sposobnosti</span>@Model.RezultatTestaSposobnosti</div><div class="field"><span class="label">Napomena</span>@Model.Napomena</div></div>
<h2>Priložena dokumentacija</h2><table class="docs"><tr><th>Dokument</th><th>Dostavljeno</th></tr>@foreach (var d in Model.Dokumentacija.OrderBy(d => d.IDDokumentacije)) { <tr><td>@d.NazivDokumenta</td><td>@(d.Dostavljeno ? "DA" : "NE")</td></tr> }</table>
@if (roditelj != null) { <h2>Roditelj/staratelj</h2><div class="grid"><div class="field"><span class="label">Ime i prezime</span>@roditelj.ImePrezime</div><div class="field"><span class="label">JMBG</span>@roditelj.JMBG</div><div class="field"><span class="label">Srodstvo</span>@roditelj.Srodstvo</div><div class="field"><span class="label">Kontakt</span>@roditelj.KontaktTelefon / @roditelj.Email</div></div> }
<div class="signatures"><span>____________________<br />Potpis kandidata/staratelja</span><span>____________________<br />Ovlašćeno lice kluba</span></div>
</div></body></html>
