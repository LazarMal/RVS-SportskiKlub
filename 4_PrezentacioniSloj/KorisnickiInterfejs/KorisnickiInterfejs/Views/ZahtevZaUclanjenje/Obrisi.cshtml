@model KlasePodataka.ZahtevZaUclanjenje
@{ ViewBag.Title = "Brisanje zahteva"; }
<div class="page-heading">
    <div><p class="page-kicker">Administratorska radnja</p><h1>Brisanje zahteva</h1></div>
</div>
<section class="surface">
    <div class="alert alert-warning">Biće obrisan zahtev <strong>@Model.BrojZahteva</strong> i svi detalji (dokumentacija, roditelj i istorija statusa).</div>
    @using (Html.BeginForm()) { @Html.AntiForgeryToken()<div class="form-actions"><button class="btn btn-danger" type="submit">Potvrdi brisanje</button> @Html.ActionLink("Odustani", "Detalji", new { id = Model.IDZahteva }, new { @class = "btn btn-default" })</div> }
</section>
