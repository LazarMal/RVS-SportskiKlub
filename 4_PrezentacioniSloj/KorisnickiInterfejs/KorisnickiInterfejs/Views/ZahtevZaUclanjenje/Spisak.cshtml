@model IEnumerable<KlasePodataka.ZahtevZaUclanjenje>
@{ ViewBag.Title = "Zahtevi za učlanjenje"; }

<div class="page-heading">
    <div>
        <p class="page-kicker">Radni pregled</p>
        <h1>Zahtevi za učlanjenje</h1>
        <p>Pretraga, obrada i štampa zahteva kandidata sportskog kluba.</p>
    </div>
</div>

@if (TempData["Poruka"] != null) { <div class="alert alert-success">@TempData["Poruka"]</div> }

<section class="surface">
    <div class="toolbar no-print">
        @using (Html.BeginForm("Spisak", "ZahtevZaUclanjenje", FormMethod.Get, new { @class = "toolbar-search" }))
        {
            <input name="pretraga" value="@ViewBag.Filter" class="form-control" placeholder="Broj, JMBG, kandidat, disciplina ili status" />
            <button class="btn btn-default" type="submit"><span class="glyphicon glyphicon-search"></span> Pretraži</button>
        }
        <div class="toolbar-actions">
            @Html.ActionLink("Novi zahtev", "Dodaj", null, new { @class = "btn btn-accent" })
            @Html.ActionLink("Štampa svih", "StampaSvih", null, new { @class = "btn btn-default", target = "_blank" })
            @Html.ActionLink("Štampa filtriranih", "StampaFiltriranih", new { pretraga = ViewBag.Filter }, new { @class = "btn btn-default", target = "_blank" })
        </div>
    </div>

    <div class="table-responsive">
        <table class="table data-table">
            <thead><tr><th>Broj</th><th>Kandidat</th><th>Disciplina</th><th>Sezona</th><th>Datum</th><th>Status</th><th>Akcije</th></tr></thead>
            <tbody>
            @foreach (var z in Model)
            {
                var statusKlasa = "status-neutral";
                if (z.StatusZahteva == "Odobren") { statusKlasa = "status-approved"; }
                else if (z.StatusZahteva == "Na proveri") { statusKlasa = "status-review"; }
                else if (z.StatusZahteva == "U obradi") { statusKlasa = "status-processing"; }
                else if (z.StatusZahteva == "Odbijen") { statusKlasa = "status-rejected"; }
                <tr>
                    <td><span class="request-number">@z.BrojZahteva</span></td>
                    <td><span class="candidate-name">@z.Kandidat.Ime @z.Kandidat.Prezime</span><span class="candidate-meta">@z.JMBGKandidata</span></td>
                    <td>@z.SportskaDisciplina.Naziv</td>
                    <td>@z.Sezona</td>
                    <td>@z.DatumPodnosenja.ToString("dd.MM.yyyy")</td>
                    <td><span class="status-chip @statusKlasa">@z.StatusZahteva</span></td>
                    <td class="row-actions">
                        @Html.ActionLink("Detalji", "Detalji", new { id = z.IDZahteva }, new { @class = "btn btn-xs btn-primary" })
                        @Html.ActionLink("Izmeni", "Izmeni", new { id = z.IDZahteva }, new { @class = "btn btn-xs btn-default" })
                        @Html.ActionLink("Štampa", "StampaZahteva", new { id = z.IDZahteva }, new { @class = "btn btn-xs btn-default", target = "_blank" })
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
