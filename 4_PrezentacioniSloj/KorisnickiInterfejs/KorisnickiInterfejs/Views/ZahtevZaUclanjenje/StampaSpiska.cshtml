@model IEnumerable<KlasePodataka.ZahtevZaUclanjenje>
@{ Layout = null; }
<!doctype html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.NaslovStampe</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 22px; color: #111; font-family: Arial, sans-serif; font-size: 11px; }
        .actions { margin-bottom: 14px; }
        .actions button { padding: 8px 14px; border: 1px solid #222; background: #fff; cursor: pointer; font-weight: bold; }
        .club { font-size: 11px; font-weight: bold; text-transform: uppercase; }
        h1 { margin: 8px 0 4px; font-size: 21px; }
        .report-meta { margin: 0 0 16px; color: #444; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 6px; border: 1px solid #555; text-align: left; vertical-align: top; }
        th { background: #ededed; font-size: 9px; letter-spacing: .04em; text-transform: uppercase; }
        small { color: #555; }
        @@page { size: A4 landscape; margin: 12mm; }
        @@media print { .actions { display: none; } body { margin: 0; } }
    </style>
</head>
<body>
    <div class="actions"><button type="button" onclick="window.print()">Štampaj spisak</button></div>
    <div class="club">SPORTSKI KLUB „MLADOST“ · Zrenjanin</div>
    <h1>@ViewBag.NaslovStampe</h1>
    @if (!string.IsNullOrWhiteSpace(ViewBag.Filter as string)) { <p>Primenjeni filter: <strong>@ViewBag.Filter</strong></p> }
    <p class="report-meta">Datum izveštaja: @DateTime.Now.ToString("dd.MM.yyyy HH:mm") · Ukupno zahteva: @Model.Count()</p>
    <table>
        <thead><tr><th>Broj</th><th>Kandidat / JMBG</th><th>Disciplina</th><th>Sezona</th><th>Datum</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var z in Model)
        {
            <tr><td>@z.BrojZahteva</td><td>@z.Kandidat.Ime @z.Kandidat.Prezime<br /><small>@z.JMBGKandidata</small></td><td>@z.SportskaDisciplina.Naziv</td><td>@z.Sezona</td><td>@z.DatumPodnosenja.ToString("dd.MM.yyyy")</td><td>@z.StatusZahteva</td></tr>
        }
        </tbody>
    </table>
</body>
</html>
