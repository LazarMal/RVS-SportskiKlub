<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - REST servis sportskog kluba</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="service-shell">
        <aside class="service-sidebar">
            <a class="service-brand" href="@Url.Action("Index", "Home", new { area = "" })">
                <span class="service-emblem" aria-hidden="true">
                    <svg viewBox="0 0 120 120" focusable="false">
                        <circle class="service-emblem-ring" cx="60" cy="60" r="52"></circle>
                        <path class="service-emblem-laurel" d="M31 83c-10-10-15-23-13-38M89 83c10-10 15-23 13-38"></path>
                        <path class="service-emblem-leaves" d="M24 69l-10-3m12-8-9-7m13-3-5-11M96 69l10-3m-12-8 9-7m-13-3 5-11"></path>
                        <path class="service-emblem-shield" d="M60 25l27 10v22c0 20-11 34-27 42-16-8-27-22-27-42V35z"></path>
                        <text class="service-emblem-monogram" x="60" y="67" text-anchor="middle">SK</text>
                    </svg>
                </span>
                <span class="service-brand-copy">
                    <strong>Sportski klub</strong>
                    <small>REST servis</small>
                </span>
            </a>

            <nav class="service-nav" aria-label="REST resursi">
                <a class="is-active" href="@Url.Action("Index", "Home", new { area = "" })">
                    <span class="glyphicon glyphicon-dashboard"></span>Pregled servisa
                </a>
                <a href="@Url.Content("~/api/zahtevi")">
                    <span class="glyphicon glyphicon-list-alt"></span>Zahtevi JSON
                </a>
                <a href="@Url.Content("~/api/parametri/poslovna-pravila")">
                    <span class="glyphicon glyphicon-cog"></span>Poslovno pravilo JSON
                </a>
            </nav>

            <div class="service-sidebar-note">
                Servisni sloj višeslojne aplikacije
            </div>
        </aside>

        <main class="service-main">
            <header class="service-topbar">
                <div>
                    <span class="service-eyebrow">Sloj servisa</span>
                    <strong>@ViewBag.Title</strong>
                </div>
                <span class="service-status"><i></i> REST API</span>
            </header>

            <div class="service-content">
                @RenderBody()
            </div>

            <footer class="service-footer">
                &copy; @DateTime.Now.Year · REST servis evidencije učlanjivanja
            </footer>
        </main>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
